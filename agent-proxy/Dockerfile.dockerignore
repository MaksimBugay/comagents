# The build context is the comagents root (build-image.sh); BuildKit reads this file because it sits next to
# Dockerfile. Only what the build stage copies goes in: agent-commons' and agent-proxy's sources, never target/,
# IDE files or the rest of the repository.
*
!agent-commons/pom.xml
!agent-commons/parent
!agent-commons/src
!agent-proxy/.mvn
!agent-proxy/mvnw
!agent-proxy/pom.xml
!agent-proxy/aot-*.properties
!agent-proxy/src
