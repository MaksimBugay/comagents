<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <artifactId>agent-commons</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <parent>
    <groupId>com.comagents</groupId>
    <artifactId>comagents-parent</artifactId>
    <version>1.0.0</version>
    <relativePath>parent/pom.xml</relativePath>
  </parent>

  <properties>
    <!-- parameter names for Jackson's @JsonCreator constructors -->
    <maven.compiler.parameters>true</maven.compiler.parameters>

    <commons-lang3.version>3.22.0</commons-lang3.version>
    <jspecify.version>1.0.0</jspecify.version>
    <pushca-client.version>2.1.2</pushca-client.version>
  </properties>

  <!-- versions not given here come from comagents-parent: the Micronaut platform, Jackson's among them -->
  <dependencies>
    <!-- brings jackson-core and jackson-annotations along -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>${commons-lang3.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- its broken-connection exceptions, which BrokenConnectionRetry retries on -->
    <dependency>
      <groupId>io.github.maksimbugay</groupId>
      <artifactId>pushca-client</artifactId>
      <version>${pushca-client.version}</version>
    </dependency>
    <!-- Micronaut's JSON engine, set up like JsonUtility (JsonUtilityMapperFactory) -->
    <dependency>
      <groupId>io.micronaut</groupId>
      <artifactId>micronaut-jackson-databind</artifactId>
    </dependency>
    <!-- Jakarta Bean Validation of request bodies and path variables -->
    <dependency>
      <groupId>io.micronaut.validation</groupId>
      <artifactId>micronaut-validation</artifactId>
    </dependency>

    <!-- test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- generates the bean definitions of the Micronaut beans here (JsonUtilityMapperFactory), which the services
           load from this jar; the platform's compiler setup runs Micronaut's annotation processor -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs combine.children="append">
            <arg>-Amicronaut.processing.group=com.comagents.commons</arg>
            <arg>-Amicronaut.processing.module=agent-commons</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
