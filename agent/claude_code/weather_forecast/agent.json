{
  "model": "deepseek-flash[1m]",
  "effort": "medium",
  "readOnly": true,
  "stateless": true,
  "allowedTools": [
    "Skill",
    "WebSearch",
    "WebFetch"
  ],
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "enableWeakerNestedSandbox": true
  },
  "kickOffPrompt": "Run the weather-forecast skill for the location given in the text item \"location\" of the session context. You are running non-interactively and nobody can answer questions: when something is unclear, make the most reasonable assumption and continue. Return the forecast, in the format the skill defines, as your final answer.",
  "requiredItems": [
    {
      "type": "STRING",
      "name": "location"
    }
  ],
  "responseSchema": {
    "type": "object",
    "required": [
      "items"
    ],
    "additionalProperties": false,
    "properties": {
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1,
        "items": {
          "type": "object",
          "required": [
            "type",
            "name",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "STRING"
            },
            "name": {
              "const": "forecast"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "description": "tomorrow's forecast for the location, or the region-not-exists notice followed by tomorrow's forecast for Tallinn"
            }
          }
        }
      }
    }
  }
}
