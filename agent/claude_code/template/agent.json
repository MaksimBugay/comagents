{
  "model": "sonnet",
  "effort": "medium",
  "allowedTools": [
    "Bash(./mvnw *)",
    "Bash(mvn *)",
    "Bash(git status)",
    "Bash(git diff *)",
    "Bash(git log *)"
  ],
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "enableWeakerNestedSandbox": true,
    "network": {
      "allowedDomains": ["repo.maven.apache.org", "repo1.maven.org"]
    }
  },
  "kickOffPrompt": "Replace with the agent's first instruction. It runs headless (claude -p): nobody can answer questions, and the final answer is returned as the agent's response.",
  "requiredItems": [
    {
      "type": "GITHUB_REPOSITORY"
    }
  ]
}
